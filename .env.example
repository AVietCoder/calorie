# =============================================================================
#  calorie-main — Environment variables
#  Copy this file to ".env" (local dev) or set these in Vercel → Settings → Env.
# =============================================================================

# ------------------------------------------------------------------------
#  LOCAL LLM (vLLM)  — REPLACES OpenAI for chat + vision
# ------------------------------------------------------------------------
# Address of your vLLM server's OpenAI-compatible API. Must end with /v1.
#   - From Vercel / the public internet, use the server's PUBLIC ip:port:
LLM_BASE_URL=http://103.73.232.112:4444/v1
#   - For local testing over an SSH tunnel, you could instead use:
#       LLM_BASE_URL=http://localhost:8000/v1

# Auth token. If you started vLLM WITHOUT --api-key, put "EMPTY".
# If you started vLLM WITH --api-key <token>, put that same token here.
LLM_API_KEY=EMPTY

# The model name you passed to `vllm serve ... --served-model-name`.
LLM_MODEL=qwen2.5-vl

# Model used for image (food photo) requests. Leave equal to LLM_MODEL when you
# serve a single vision-language model such as Qwen3-VL (handles text + images).
LLM_VISION_MODEL=qwen2.5-vl

# ------------------------------------------------------------------------
#  KNOWLEDGE BASE — PostgreSQL Full Text Search (NO embeddings, NO API key)
# ------------------------------------------------------------------------
# The Knowledge Base (uploaded PDFs + built-in disease-routed docs) is
# retrieved with native PostgreSQL Full Text Search (tsvector + GIN index +
# ts_rank) — see migrations/fulltext_search.sql. There is NO embedding
# server, NO embedding API key, and NO vector database to configure here.
#
# Setup (one-time):
#   1) Run migrations/admin.sql, then migrations/fulltext_search.sql on the
#      Supabase SQL editor.
#   2) (optional) Seed the built-in disease-routed base layer:
#        node scripts/seed-base-knowledge.mjs
#
# Tunables (all optional):
# RAG_DEBUG=1            # verbose per-stage retrieval logs
# RAG_KB_MIN_RANK=0.01   # strict-KB gate: min ts_rank score to count as a hit
# RAG_ROUTE_BONUS=0.05   # extra score for a base-layer doc matching profile.disease
# RAG_ADMIN_BONUS=0.01   # small score nudge for admin-uploaded chunks

# ------------------------------------------------------------------------
#  (Legacy) OpenAI cloud — only needed if you ever want to switch back.
#  Leave blank when using the local vLLM server above.
# ------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ------------------------------------------------------------------------
#  Supabase (database + auth)  — REQUIRED
# ------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional:
# SUPABASE_PDF_BUCKET=admin-pdfs
# SUPABASE_SIGNED_URL_TTL=3600

# ------------------------------------------------------------------------
#  Cloudinary (PDF uploads for the admin knowledge base)  — optional
# ------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=
# CLOUDINARY_PDF_FOLDER=calorie-rag-pdfs

# ------------------------------------------------------------------------
#  Admin + misc
# ------------------------------------------------------------------------
# Comma-separated list of admin emails.
# ADMIN_EMAILS=you@example.com
# DEBUG_COACH=1
# NODE_ENV=production
# ------------------------------------------------------------------------
#  NHẬN DIỆN ẢNH MÓN ĂN — tuỳ chọn dùng Gemini cho chính xác hơn Qwen
# ------------------------------------------------------------------------
# Để TRỐNG => 100% dùng Qwen local (0 token cloud).
# Đặt GEMINI_API_KEY => ảnh món ăn nhận diện bằng Google Gemini (chính xác hơn
# với món Việt), lỗi sẽ tự fallback về Qwen. Lấy key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# VISION_PROVIDER=gemini

# ------------------------------------------------------------------------
#  NGUON DU LIEU DINH DUONG NGOAI (lib/nutrition.js) - tuy chon
# ------------------------------------------------------------------------
# USDA FoodData Central API key (uu tien so 1 khi tra cuu moc /100g cua thuc
# pham do duoc bang ml/g). Lay key mien phi: https://fdc.nal.usda.gov/api-key-signup
# Khong dat -> bo qua USDA, tu dong dung OpenFoodFacts (khong can key) roi AI.
# FDC_API_KEY=
