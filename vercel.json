{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "api/knowledge/**"
    },
    "api/admin.js": {
      "includeFiles": "api/knowledge/**",
      "maxDuration": 60
    },
    "api/chat.js": {
      "includeFiles": "api/knowledge/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
