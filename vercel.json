{
  "functions": {
    "api/index.js": {
      "includeFiles": "knowledge/**"
    },
    "api/admin.js": {
      "includeFiles": "knowledge/**",
      "maxDuration": 60
    },
    "api/analyze-food.js": {
      "maxDuration": 120
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/chat-history.js": {
      "maxDuration": 10
    },
    "api/chat.js": {
      "includeFiles": "knowledge/**",
      "maxDuration": 300
    },
    "api/coach-dynamic.js": {
      "includeFiles": "knowledge/**",
      "maxDuration": 300
    },
    "api/diet-info.js": {
      "maxDuration": 10
    },
    "api/setup.js": {
      "maxDuration": 10
    },
    "api/status.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}